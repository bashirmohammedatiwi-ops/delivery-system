# PostgreSQL — انسخ إلى .env (استخدم كلمة سر ASCII فقط، بدون عربي)
POSTGRES_DB=delivery
POSTGRES_USER=delivery
POSTGRES_PASSWORD=change_me_use_openssl_rand_hex_16
# للنقل من السيرفر (خارج Docker): postgres://...@127.0.0.1:5432/delivery
# docker-compose.yml يبني DATABASE_URL تلقائياً داخل الحاوية عبر hostname: postgres
PG_POOL_MAX=20

# للعودة مؤقتاً إلى SQLite: احذف DATABASE_URL من .env وأعد تشغيل التطبيق
